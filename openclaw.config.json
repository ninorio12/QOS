{
  "gateway": {
    "port": 18789,
    "host": "localhost"
  },
  "agent": {
    "model": "anthropic/claude-opus-4-6",
    "soul": ".agents/soren/SOUL.md"
  },
  "sessions": {
    "kai": {
      "model": "anthropic/claude-sonnet-4-6",
      "soul": ".agents/kai/SOUL.md"
    },
    "mia": {
      "model": "anthropic/claude-haiku-4-5-20251001",
      "soul": ".agents/mia/SOUL.md"
    }
  },
  "skills": {
    "soren": ["ghl-pipeline", "telegram-digest", "sessions-delegate"],
    "kai": ["twilio-sms", "ghl-contacts", "ghl-opportunities", "calendar-book"],
    "mia": ["devis-generator", "kb-sync", "file-archive"]
  },
  "cron": {
    "daily-digest": "0 7 * * *",
    "weekly-report": "0 9 * * 1",
    "devis-followup": "0 * * * *"
  },
  "integrations": {
    "anthropic": { "env": "ANTHROPIC_API_KEY" },
    "twilio": { "env": ["TWILIO_ACCOUNT_SID", "TWILIO_AUTH_TOKEN", "TWILIO_PHONE_NUMBER"] },
    "telegram": { "env": ["TELEGRAM_BOT_TOKEN", "TELEGRAM_CHAT_ID"] },
    "ghl": { "env": ["GHL_API_KEY", "GHL_LOCATION_ID"] },
    "supabase": { "env": ["SUPABASE_URL", "SUPABASE_SERVICE_KEY"] }
  }
}
